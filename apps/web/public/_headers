# Headers for static assets, which Workers serves without running src/server.ts.
# Keep the security headers in sync with src/server.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Vite puts a content hash in every file name here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every font URL carries a version query (?v=3.19 in styles.css and
# routes/__root.tsx). Bump it when a font file changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Image names aren't hashed, so a changed image must reach browsers in a day.
/images/*
  Cache-Control: public, max-age=86400

# RFC 9727 API catalog.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Access-Control-Allow-Origin: *

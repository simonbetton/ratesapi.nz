{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:setup && wrangler dev --env development --local",
    "dev:remote": "wrangler dev --env development",
    "build": "wrangler deploy --env '' --dry-run --outdir dist --minify",
    "deploy": "wrangler deploy --env '' --minify",
    "typecheck": "tsgo --noEmit",
    "test:browser": "node node_modules/playwright/cli.js test --config playwright.config.ts",
    "db:setup": "bun bin/init-local-d1.ts && bun bin/seed-local-d1.ts",
    "db:migrate": "bun bin/migrate-d1.ts",
    "scrape": "node --max-http-header-size=65536 --import tsx bin/scrape-all-rates.ts",
    "scrape:local": "D1_DATABASE_NAME=ratesapi-data D1_LOCAL=true bun run scrape",
    "uptime": "bun bin/uptime-check.ts",
    "sources:audit": "node --max-http-header-size=65536 --import tsx bin/audit-direct-sources.ts",
    "sources:browser": "node --max-http-header-size=65536 --import tsx bin/audit-browser-sources.ts"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "cheerio": "1.2.0",
    "elysia": "^1.4.30",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "domhandler": "^6.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "unpdf": "2.1.0",
    "wrangler": "catalog:"
  }
}

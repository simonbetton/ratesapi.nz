{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "bun run db:setup && wrangler dev --env development --local",
    "dev:remote": "wrangler dev --env development",
    "build": "wrangler deploy --env '' --dry-run --outdir dist --minify",
    "deploy": "wrangler deploy --env '' --minify",
    "typecheck": "tsgo --noEmit",
    "db:setup": "bun bin/init-local-d1.ts && bun bin/seed-local-d1.ts",
    "scrape": "bun bin/scrape-mortgage-rates.ts && bun bin/scrape-personal-loan-rates.ts && bun bin/scrape-car-loan-rates.ts && bun bin/scrape-credit-card-rates.ts",
    "scrape:local": "D1_DATABASE_NAME=ratesapi-data D1_LOCAL=true bun run scrape",
    "uptime": "bun bin/uptime-check.ts"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "cheerio": "1.2.0",
    "elysia": "^1.4.30",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "domhandler": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "wrangler": "catalog:"
  }
}

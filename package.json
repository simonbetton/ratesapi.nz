{
  "name": "ratesapi",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "typescript": "^7.0.2",
      "wrangler": "^4.137.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "deploy": "bun run --filter '*' deploy",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "doctor": "react-doctor",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "react-doctor": "^0.9.14",
    "typescript": "catalog:"
  }
}
